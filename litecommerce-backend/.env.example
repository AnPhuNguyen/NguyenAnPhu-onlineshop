# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306 # Thay thành 3307 nếu bạn sử dụng bản cài đặt MySQL khác
DB_USERNAME=root
DB_PASSWORD= # Điền mật khẩu root MySQL của bạn (ví dụ: root hoặc 123456)
DB_DATABASE=litecommercedb

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
